local function SpawnMessage(slot,Time)
	local SpawnTime = tick() - Timer
	local mistaketime = SpawnTime - Time
	Timer = tick()
	if mistaketime > .1 then
		warn("Spawn "..slot.." "..SpawnTime.." MISTAKE "..mistaketime)
	else
		print("Spawn "..slot.." "..SpawnTime)
	end
end

AutoFarmList:Button({
	Text = "Start",
	Callback = function()
		game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("RemoteFunction"):WaitForChild("StartBattle"):InvokeServer(unpack(TBB.StageData))
		repeat task.wait() until workspace.NPCFolders.BaseFolder:FindFirstChild("Red Base")
		Timer = tick()
		Money = game:GetService("Players").LocalPlayer.PlayerGui:WaitForChild("BattleScreen").Info.BankText

		task.spawn(function()
			for i,v in ipairs(TBB.SpawnData) do
				local slot = v[1]
				local Time = v[2]
				local Price
				if slot ~= "Bank" and slot ~= "Cannon" then
					if game:GetService("Players").LocalPlayer.PlayerGui.BattleScreen.MobileSpawnMenu.Visible then
						Price = (game:GetService("Players").LocalPlayer.PlayerGui.BattleScreen.MobileSpawnMenu.Bar1:FindFirstChild(slot) or game:GetService("Players").LocalPlayer.PlayerGui.BattleScreen.MobileSpawnMenu.Bar2:FindFirstChild(slot)).CostText.Text
					else
						Price = (game:GetService("Players").LocalPlayer.PlayerGui.BattleScreen.SpawnMenu.Bar1:FindFirstChild(slot) or game:GetService("Players").LocalPlayer.PlayerGui.BattleScreen.SpawnMenu.Bar2:FindFirstChild(slot)).CostText.Text
					end
				elseif slot == "Bank" then
					Price = game:GetService("Players").LocalPlayer.PlayerGui.BattleScreen.BankButton.Upgrade.Text
				end
				task.wait(Time)
				
				if slot == "Cannon" then
					if game:GetService("Players").LocalPlayer.PlayerGui.BattleScreen.CannonButton.CostText.Visible then
						game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("RemoteFunction"):WaitForChild("PlayerSpawn"):InvokeServer(slot)
						SpawnMessage(slot,Time)
					else
						repeat task.wait() until Money.Text > game:GetService("Players").LocalPlayer.PlayerGui.BattleScreen.CannonButton.CostText.Visible
						game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("RemoteFunction"):WaitForChild("PlayerSpawn"):InvokeServer(slot)
						SpawnMessage(slot,Time)
					end
				else

					
					if Money.Text >= Price then
						game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("RemoteFunction"):WaitForChild("PlayerSpawn"):InvokeServer(slot)
						Timer = tick()
						SpawnMessage(slot,Time)
					else
						repeat task.wait() until Money.Text > Price
						game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("RemoteFunction"):WaitForChild("PlayerSpawn"):InvokeServer(slot)
						SpawnMessage(slot,Time)
					end
				end

			end
			
		end)
		
		task.spawn(function()
			while AutoStart.Value do
				task.wait()
				game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("RemoteFunction"):WaitForChild("StartBattle"):InvokeServer(unpack(TBB.StageData))
			end
		end)
	end,
})

