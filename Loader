--TBB Module

function TBB:Loadout(Loadout)
	local Type = {}
	local Slots = {}
	local Base = Loadout["Base"]
	
	for i,v in ipairs(Loadout["Type"]) do
		print(v)
		table.insert(Type,(#Type + 1),{"Slot"..i,v})
	end
	
	for i,v in ipairs(Loadout["Slots"]) do
		table.insert(Slots,(#Slots + 1),{"Slot"..i,v})
	end
	
	game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("RemoteEvents"):WaitForChild("SaveLoadout"):FireServer({Type = Type,Slots = Slots,Base = Base})
end

function TBB:Stage(args)
	for i,v in ipairs(args) do
		table.insert(TBB.StageData,i,v)
	end
end

function TBB:Spawn(slot,Time)
	table.insert(TBB.SpawnData,(#TBB.SpawnData + 1),{slot,Time})
end
