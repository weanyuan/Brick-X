local InsertService = game:GetService("InsertService")

local ReGui = loadstring(game:HttpGet('https://raw.githubusercontent.com/depthso/Dear-ReGui/refs/heads/main/ReGui.lua'))()
local PrefabsId = "rbxassetid://" .. ReGui.PrefabsId

--// Declare the Prefabs asset
ReGui:Init({
	Prefabs = InsertService:LoadLocalAsset(PrefabsId)
})
----------
local Timer
local Money
local Stage

local TBB = {
	SpawnData = {},
	LoadoutData = {},
	StageData = {}
}



function TBB:Loadout(Loadout)
	local Type = {}
	local Slots = {}
	local Base = Loadout["Base"]
	
	for i,v in ipairs(Loadout["Type"]) do
		print(v)
		table.insert(Type,(#Type + 1),{"Slot"..i,v})
	end
	
	for i,v in ipairs(Loadout["Slots"]) do
		table.insert(Slots,(#Slots + 1),{"Slot"..i,v})
	end
	
	game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("RemoteEvents"):WaitForChild("SaveLoadout"):FireServer({Type = Type,Slots = Slots,Base = Base})
end

function TBB:Stage(args)
	for i,v in ipairs(args) do
		table.insert(TBB.StageData,i,v)
	end
end

function TBB:Spawn(slot,Time)
	table.insert(TBB.SpawnData,(#TBB.SpawnData + 1),{slot,Time})
end


local Window = ReGui:TabsWindow({
	Title = "Main",
	Size = UDim2.fromOffset(300, 200),
	Position = UDim2.fromScale(.5,.5)
}) --> Canvas & WindowClass

local Main = Window:CreateTab({
	Name = "Main"

})

local Recorder = Window:CreateTab({
	Name = "Recorder"

})

Main:Button({
	Text = "Start",
	Callback = function()
		game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("RemoteFunction"):WaitForChild("StartBattle"):InvokeServer(unpack(TBB.StageData))
		repeat task.wait() until workspace.NPCFolders.BaseFolder:FindFirstChild("Red Base")
		Timer = tick()
		Money = game:GetService("Players").LocalPlayer.PlayerGui:WaitForChild("BattleScreen").Info.BankText

		task.spawn(function()
			for i,v in ipairs(TBB.SpawnData) do
				local slot = v[1]
				local Time = v[2]
				task.wait(Time)
				local oPrice
				if slot ~= "Bank" and slot ~= "Cannon" then
				    if game:GetService("Players").LocalPlayer.PlayerGui.BattleScreen.MobileSpawnMenu.Visible then
					oPrice = (game:GetService("Players").LocalPlayer.PlayerGui.BattleScreen.MobileSpawnMenu.Bar1:FindFirstChild(slot) or game:GetService("Players").LocalPlayer.PlayerGui.BattleScreen.MobileSpawnMenu.Bar2:FindFirstChild(slot)).CostText.Text
				    else
					oPrice = (game:GetService("Players").LocalPlayer.PlayerGui.BattleScreen.SpawnMenu.Bar1:FindFirstChild(slot) or game:GetService("Players").LocalPlayer.PlayerGui.BattleScreen.SpawnMenu.Bar2:FindFirstChild(slot)).CostText.Text
					end
				elseif slot == "Bank" then
					oPrice = game:GetService("Players").LocalPlayer.PlayerGui.BattleScreen.BankButton.Upgrade.Text
				end
				
				if slot == "Cannon" then
					if game:GetService("Players").LocalPlayer.PlayerGui.BattleScreen.CannonButton.CostText.Visible then
						game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("RemoteFunction"):WaitForChild("PlayerSpawn"):InvokeServer(slot)
					else
						repeat task.wait() until Money.Text > game:GetService("Players").LocalPlayer.PlayerGui.BattleScreen.CannonButton.CostText.Visible
						local mistaketime = (tick() - Timer) - Time
						Timer = tick()
						if mistaketime > .1 then
							warn("MISTAKE "..mistaketime)
						end
					end
				else
					local Price = string.gsub(oPrice,"%D", "")
					if Money.Text >= Price then
						game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("RemoteFunction"):WaitForChild("PlayerSpawn"):InvokeServer(slot)
						Timer = tick()
					else
						repeat task.wait() until Money.Text > Price
						game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("RemoteFunction"):WaitForChild("PlayerSpawn"):InvokeServer(slot)
						local mistaketime = (tick() - Timer) - Time
						Timer = tick()
						if mistaketime > .1 then
							warn("MISTAKE "..mistaketime)
						end
					end
				end

			 end
		end)
	end,
})

Recorder:Label({Text = "Recorder"})
Recorder:Button({
	Text = "Recorder",
	Callback = function()
		loadstring(game:HttpGet("https://raw.githubusercontent.com/weanyuan/Brick-X/refs/heads/main/Recorder"))()
	end,
})

return TBB
