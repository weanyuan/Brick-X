local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ReGui = require(ReplicatedStorage.ReGui)
ReGui:Init()

local Closed = false

local Window = ReGui:Window({
	Title = "Recorder",
	Size = UDim2.fromOffset(300, 200),
	Position = UDim2.fromScale(.5,.5),
	CloseCallback = function()
		Closed = true
	end,
})
Window:Separator({
	Text = "Last operation:"
})

local LastOperation = Window:Label({
	Text = "not started yet"
})

Window:Label({Text = ""})


local RecordName = Window:InputText({
	Value = "",
	Label = "Input record file's name",
	Placeholder = "TBB-X",
	Size = UDim2.new(0.25, 0,0, 19)
})

local String = "--v0.1".."\n".."local TBB = loadstring(game:HttpGet('https://raw.githubusercontent.com/weanyuan/Brick-X/refs/heads/main/Loader'))()".."\n"
local Data = {}
local Loadout = {}
local Timer
local StartBattle
local PlayerSpawn
local Stage



StartBattle = hookmetamethod(game,"__namecall",function(self,...)
	local args = {...}
	if getnamecallmethod() == "InvokeServer" and self.Name == "StartBattle" and not Closed then
		task.spawn(function()
			repeat task.wait() until workspace.NPCFolders.BaseFolder:FindFirstChild("Red Base")
			local event
			Timer = tick()
			for index,value in ipairs(game:GetService("Players").LocalPlayer.PlayerData.Loadout:GetChildren()) do
				Loadout[value.Name] = {}
				-- Base Slots Type
				if value.Name == "Base" then
					Loadout[value.Name][1] = value.Cannon.Value
					Loadout[value.Name][2] = value.Bank.Value
				end
				for i,v in ipairs(value:GetChildren()) do
					if v:IsA("NumberValue") or v:IsA("StringValue") then
						table.insert(Loadout[value.Name],v.Value)
					end
				end
			end
			Stage = args
			event = workspace.NPCFolders.BaseFolder:WaitForChild("Red Base"):WaitForChild("Humanoid").HealthChanged:Connect(function(hp)
				if hp <= 0 then
					event:Disconnect()
					print("DEAD")
					local LoadoutString = "\n{Base = {"
					

					LoadoutString = LoadoutString.."Cannon ="..Loadout["Base"][1]..","
					LoadoutString = LoadoutString.."Bank ="..Loadout["Base"][2]
					
					LoadoutString = LoadoutString.."},\n Slots = {"
					for i,v in ipairs(Loadout["Slots"]) do
						LoadoutString = LoadoutString..tostring(v)..","
					end
					LoadoutString = LoadoutString.."},\n Type = {"
					for i,v in ipairs(Loadout["Type"]) do
						LoadoutString = LoadoutString..'"'..tostring(v)..'"'..","
					end
					LoadoutString = LoadoutString.."}\n}"
					
					
					String = String.."TBB:Loadout("..LoadoutString..")\n"
					local stagev1,stagev2,stagev3,stagev4,stagev5,stagev6,stagev7 = unpack(Stage)
					String = String.."TBB:Stage({"..'"'..stagev1..'"'..","..tostring(stagev2)..","..tostring(stagev3)..","..tostring(stagev4)..","..tostring(stagev5)..",".."{}"..","..tostring(stagev7).."})\n"
					
					for i,v in ipairs(Data) do
						local value1,value2 = unpack(v)
						local TempString = "TBB:Spawn("..'"'..tostring(value1)..'"'..","..tostring(value2)..")".."\n"
						String = String..TempString
					end
					
					LastOperation.Text = "Recording completed"
					writefile(RecordName..".txt",String)
				end
			end)
		end)
	end
	return StartBattle(self,unpack(args))
end)


PlayerSpawn = hookmetamethod(game, "__namecall", function(self, ...)
	local args = {...}
	local namecallMethod = getnamecallmethod()

	if namecallMethod == "InvokeServer" and self.Name == "PlayerSpawn" and not Closed then
		local result = PlayerSpawn(self, unpack(args))
		if result then
			print("Spawn",args[1],result)
			local SpawnTime = tick() - Timer
			Timer = tick()
			table.insert(Data,{args[1],SpawnTime})
			LastOperation.Text = "Spawn "..args[1].." "..result
		end
		return result
	end

	return PlayerSpawn(self, unpack(args))
end)

